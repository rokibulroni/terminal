    },
    {
      "id": 7,
      "category": "Viewing",
      "command": "HISTTIMEFORMAT=\"%F %T \" history",
      "example": "HISTTIMEFORMAT=\"%F %T \" history",
      "explanation": "Shows when each command was run (bash records times only if this was set when they ran)."
    },
    {
      "id": 8,
      "category": "Re-running",
      "command": "!!",
      "example": "!!",
      "explanation": "Repeats the last command — sudo !! reruns it as root."
    },
    {
      "id": 9,
      "category": "Re-running",
      "command": "!<n>",
      "example": "!42",
      "explanation": "Runs command number n."
    },
    {
      "id": 10,
      "category": "Re-running",
      "command": "!<prefix>",
      "example": "!ssh",
      "explanation": "Runs the most recent command starting with the text."
    },
    {
      "id": 11,
      "category": "Re-running",
      "command": "!$",
      "example": "!$",
      "explanation": "The last argument of the previous command."
    },
    {
      "id": 12,
      "category": "Re-running",
      "command": "^<old>^<new>",
      "example": "^tcp^udp",
      "explanation": "Reruns the previous command with a substitution."
    },
    {
      "id": 3,
      "category": "Managing",
      "command": "history -c",
