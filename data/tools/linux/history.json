    {
      "id": 13,
      "category": "Managing",
      "command": "history -d <n>",
      "example": "history -d 105",
      "explanation": "Deletes one entry."
    },
    {
      "id": 14,
      "category": "Managing",
      "command": "history -a",
      "example": "history -a",
      "explanation": "Writes this session’s commands to the history file now."
    },
    {
      "id": 15,
      "category": "Managing",
      "command": " <command>",
      "example": " export API_KEY=secret",
      "explanation": "With HISTCONTROL=ignorespace, a leading space keeps a command out of history."
    },
    {
      "id": 16,
      "category": "Forensics",
      "command": "cat /home/*/.bash_history /root/.bash_history 2>/dev/null",
      "example": "cat /home/*/.bash_history /root/.bash_history 2>/dev/null",
      "explanation": "Reads history files for every user. Empty or missing files, or a link to /dev/null, can indicate tampering."
    },
    {
      "id": 17,
      "category": "Forensics",
      "command": "ls -la ~/.*history",
      "example": "ls -la ~/.*history",
      "explanation": "Lists history files for different shells (bash, zsh, python, mysql, less)."
    }
  ]
