      "explanation": "Creates several directories at once."
    },
    {
      "id": 7,
      "category": "Basics",
      "command": "mkdir -p <dir>/{<a>,<b>,<c>}",
      "example": "mkdir -p engagement/{recon,exploit,loot,report}",
      "explanation": "Brace expansion builds a whole project layout in one go."
    },
    {
      "id": 8,
      "category": "Basics",
      "command": "mkdir -m <mode> <dir>",
      "example": "mkdir -m 700 private",
      "explanation": "Sets permissions at creation — 700 means only the owner can enter."
    },
    {
      "id": 9,
      "category": "Basics",
      "command": "mkdir -v <dir>",
      "example": "mkdir -v <dir>",
      "explanation": "Prints each directory created."
    },
    {
      "id": 10,
      "category": "Basics",
      "command": "mkdir -p <dir> && cd <dir>",
      "example": "mkdir -p work && cd work",
      "explanation": "Creates a directory and enters it."
    },
    {
      "id": 11,
      "category": "Basics",
      "command": "mktemp -d",
      "example": "mktemp -d",
      "explanation": "Creates a uniquely named temporary directory and prints its path — safer than a fixed name in /tmp."
