  "total_commands": 13,
  "commands": [
    {
      "id": 5,
      "category": "Viewing",
      "command": "cat <file>",
      "example": "cat /etc/os-release",
      "explanation": "Prints a file to the terminal. /etc/os-release is a quick way to identify the distribution."
    },
    {
      "id": 6,
      "category": "Viewing",
      "command": "cat -n <file>",
      "example": "cat -n script.sh",
      "explanation": "Numbers every output line."
    },
    {
      "id": 7,
      "category": "Viewing",
      "command": "cat -b <file>",
      "example": "cat -b config.ini",
      "explanation": "Numbers only non-blank lines."
    },
    {
      "id": 8,
      "category": "Viewing",
      "command": "cat -A <file>",
      "example": "cat -A data.csv",
      "explanation": "Reveals hidden characters: tabs as ^I, line ends as $ — great for spotting Windows line endings (^M$)."
    },
    {
      "id": 9,
      "category": "Viewing",
      "command": "cat -s <file>",
      "example": "cat -s notes.txt",
      "explanation": "Squeezes repeated blank lines into one."
    },
    {
      "id": 10,
      "category": "Combining and creating",
      "command": "cat <file1> <file2> > <out>",
      "example": "cat part1.txt part2.txt > full.txt",
      "explanation": "Concatenates files into a new file."
    },
    {
      "id": 11,
      "category": "Combining and creating",
      "command": "cat <file> >> <out>",
      "example": "cat new-hosts.txt >> targets.txt",
      "explanation": "Appends a file to the end of another."
    },
    {
      "id": 12,
      "category": "Combining and creating",
      "command": "cat > <file> << 'EOF'",
      "example": "cat > hello.sh << 'EOF'\n#!/bin/sh\necho hello\nEOF",
      "explanation": "Writes multiple lines into a file using a here-document; quoting EOF stops variable expansion."
    },
    {
      "id": 13,
      "category": "Combining and creating",
      "command": "cat -",
      "example": "cat -",
      "explanation": "Reads from standard input until Ctrl-D — a quick way to paste text."
    },
    {
      "id": 14,
      "category": "Recon",
      "command": "cat /etc/passwd",
      "example": "cat /etc/passwd",
      "explanation": "Lists local accounts, their UID/GID, home directory and login shell."
    },
    {
      "id": 15,
      "category": "Recon",
      "command": "cat /proc/version",
      "example": "cat /proc/version",
      "explanation": "Shows the kernel version and the compiler used to build it."
    },
    {
      "id": 16,
      "category": "Recon",
      "command": "cat /etc/hosts",
      "example": "cat /etc/hosts",
      "explanation": "Shows static hostname mappings, which can reveal internal hosts."
    },
    {
      "id": 17,
      "category": "Recon",
      "command": "cat ~/.bash_history",
      "example": "cat ~/.bash_history",
      "explanation": "Reads the shell history — often contains typed passwords, hostnames and paths."
    }
  ]
}
