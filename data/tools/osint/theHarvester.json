{
  "tool": "theHarvester",
  "name": "theHarvester",
  "description": "Gathers emails, names, subdomains, IPs and URLs about a domain from public sources like search engines and certificate logs.",
  "tags": [
    "emails",
    "subdomains",
    "reconnaissance"
  ],
  "homepage": "https://github.com/laramies/theHarvester",
  "docs": "https://github.com/laramies/theHarvester/wiki",
  "install": {
    "apt": "sudo apt install theharvester"
  },
  "related": [
    "amass",
    "recon-ng",
    "spiderfoot"
  ],
  "total_commands": 13,
  "commands": [
    {
      "id": 11,
      "category": "Collecting",
      "command": "theHarvester -d <domain> -b <sources>",
      "example": "theHarvester -d example.com -b crtsh,duckduckgo,bing",
      "explanation": "Searches the chosen sources for emails, hosts and IPs related to the domain."
    },
    {
      "id": 2,
      "category": "Collecting",
      "command": "theHarvester -d <domain> -b all",
      "example": "theHarvester -d example.com -b all",
      "explanation": "Queries every available source. Sources that need API keys are skipped unless keys are configured."
    },
    {
      "id": 12,
      "category": "Collecting",
      "command": "theHarvester -d <domain> -b crtsh",
      "example": "theHarvester -d example.com -b crtsh",
      "explanation": "Subdomains from certificate-transparency logs — fast and keyless."
    },
    {
      "id": 13,
      "category": "Collecting",
      "command": "theHarvester -d <domain> -b <source> -l <n>",
      "example": "theHarvester -d example.com -b bing -l 500",
      "explanation": "Limits the number of results fetched from search engines."
    },
    {
      "id": 14,
      "category": "Collecting",
      "command": "theHarvester -d <domain> -b <source> -S <start>",
      "example": "theHarvester -d example.com -b bing -S 100",
      "explanation": "Starts from a later result offset."
    },
    {
      "id": 15,
      "category": "Active checks",
      "command": "theHarvester -d <domain> -b <source> -r",
      "example": "theHarvester -d example.com -b crtsh -r",
      "explanation": "Resolves discovered hosts with DNS."
    },
    {
      "id": 16,
      "category": "Active checks",
      "command": "theHarvester -d <domain> -b <source> -c",
      "example": "theHarvester -d example.com -b crtsh -c",
      "explanation": "DNS brute-forces subdomains."
    },
    {
      "id": 17,
      "category": "Active checks",
      "command": "theHarvester -d <domain> -b <source> -n",
      "example": "theHarvester -d example.com -b crtsh -n",
      "explanation": "Reverse DNS lookups on discovered IP ranges."
    },
    {
      "id": 18,
      "category": "Active checks",
      "command": "theHarvester -d <domain> -b <source> -t",
      "example": "theHarvester -d example.com -b crtsh -t",
      "explanation": "Checks discovered hosts for subdomain-takeover candidates."
    },
    {
      "id": 19,
      "category": "Active checks",
      "command": "theHarvester -d <domain> -b shodan",
      "example": "theHarvester -d example.com -b shodan",
      "explanation": "Enriches hosts with Shodan data (needs an API key)."
    },
    {
      "id": 20,
      "category": "Output",
      "command": "theHarvester -d <domain> -b <source> -f <file>",
      "example": "theHarvester -d example.com -b all -f example_report",
      "explanation": "Saves results as XML and JSON."
    },
    {
      "id": 21,
      "category": "Output",
      "command": "theHarvester -d <domain> -b <source> -q",
      "example": "theHarvester -d example.com -b crtsh -q",
      "explanation": "Quiet mode with fewer warnings."
    },
    {
      "id": 22,
      "category": "Output",
      "command": "cat ~/.theHarvester/api-keys.yaml",
      "example": "cat ~/.theHarvester/api-keys.yaml",
      "explanation": "API key configuration file (in /etc/theHarvester/ on some installs). Adding keys unlocks sources like Hunter, Shodan and SecurityTrails."
    }
  ]
}
