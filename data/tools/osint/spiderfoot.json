{
  "tool": "spiderfoot",
  "name": "SpiderFoot",
  "description": "Automates OSINT collection across 200+ modules and correlates results about IPs, domains, emails, names and more, via CLI or web UI.",
  "tags": [
    "automation",
    "reconnaissance",
    "correlation"
  ],
  "homepage": "https://github.com/smicallef/spiderfoot",
  "docs": "https://github.com/smicallef/spiderfoot#readme",
  "install": {
    "apt": "sudo apt install spiderfoot",
    "docker": "docker run -p 5001:5001 smicallef/spiderfoot"
  },
  "related": [
    "recon-ng",
    "theHarvester",
    "shodan"
  ],
  "total_commands": 14,
  "commands": [
    {
      "id": 11,
      "category": "Web UI",
      "command": "spiderfoot -l 127.0.0.1:5001",
      "example": "spiderfoot -l 127.0.0.1:5001",
      "explanation": "Starts the web interface on port 5001. Keep it on localhost; it has no authentication by default."
    },
    {
      "id": 12,
      "category": "Web UI",
      "command": "docker run -p 127.0.0.1:5001:5001 smicallef/spiderfoot",
      "example": "docker run -p 127.0.0.1:5001:5001 smicallef/spiderfoot",
      "explanation": "Runs the web UI in Docker, published only on localhost."
    },
    {
      "id": 13,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u passive",
      "example": "spiderfoot -s example.com -u passive",
      "explanation": "Runs every module that does not touch the target directly."
    },
    {
      "id": 14,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u footprint",
      "example": "spiderfoot -s example.com -u footprint",
      "explanation": "Footprinting: maps the target’s internet presence."
    },
    {
      "id": 15,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u investigate",
      "example": "spiderfoot -s 203.0.113.10 -u investigate",
      "explanation": "Investigation: looks for malicious indicators about the target."
    },
    {
      "id": 16,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u all",
      "example": "spiderfoot -s example.com -u all",
      "explanation": "Every module — slow and can be noisy."
    },
    {
      "id": 17,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -m <modules>",
      "example": "spiderfoot -s example.com -m sfp_dnsresolve,sfp_crt,sfp_whois",
      "explanation": "Only the listed modules."
    },
    {
      "id": 18,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -t <types>",
      "example": "spiderfoot -s example.com -t EMAILADDR,INTERNET_NAME",
      "explanation": "Only collects certain data types."
    },
    {
      "id": 19,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u passive -o json > <file>",
      "example": "spiderfoot -s example.com -u passive -o json > results.json",
      "explanation": "JSON output for later processing; csv and tab are also available."
    },
    {
      "id": 20,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u passive -q",
      "example": "spiderfoot -s example.com -u passive -q",
      "explanation": "Hides log messages and prints only results."
    },
    {
      "id": 21,
      "category": "Command-line scans",
      "command": "spiderfoot -s <target> -u passive -x -t <type>",
      "example": "spiderfoot -s example.com -x -t EMAILADDR",
      "explanation": "Strict mode: only modules that directly produce the requested type."
    },
    {
      "id": 22,
      "category": "Reference",
      "command": "spiderfoot -M",
      "example": "spiderfoot -M",
      "explanation": "Lists all modules with short descriptions."
    },
    {
      "id": 23,
      "category": "Reference",
      "command": "spiderfoot -T",
      "example": "spiderfoot -T",
      "explanation": "Lists every data type modules can produce."
    },
    {
      "id": 24,
      "category": "Reference",
      "command": "spiderfoot -C <scan_id>",
      "example": "spiderfoot -C 3F6A2B…",
      "explanation": "Runs the correlation rules against a completed scan."
    }
  ]
}
