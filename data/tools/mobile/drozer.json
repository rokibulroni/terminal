{
  "tool": "drozer",
  "name": "drozer",
  "description": "A security-testing framework for Android that interacts with app components — activities, providers, services — over IPC to find weaknesses.",
  "tags": [
    "Android",
    "IPC",
    "app security"
  ],
  "homepage": "https://github.com/WithSecureLabs/drozer",
  "docs": "https://github.com/WithSecureLabs/drozer#usage",
  "install": {
    "pipx": "pipx install drozer"
  },
  "related": [
    "adb",
    "frida",
    "apktool"
  ],
  "total_commands": 18,
  "commands": [
    {
      "id": 11,
      "category": "Connecting",
      "command": "adb forward tcp:31415 tcp:31415",
      "example": "adb forward tcp:31415 tcp:31415",
      "explanation": "Forwards the drozer agent port from the device. Start the drozer Agent app and turn its server on first."
    },
    {
      "id": 1,
      "category": "Connecting",
      "command": "drozer console connect",
      "example": "drozer console connect",
      "explanation": "Connects to the agent and opens the drozer console."
    },
    {
      "id": 12,
      "category": "Connecting",
      "command": "drozer console connect --server <ip>",
      "example": "drozer console connect --server 192.168.1.50",
      "explanation": "Connects to an agent over the network."
    },
    {
      "id": 13,
      "category": "Recon",
      "command": "run app.package.list -f <filter>",
      "example": "run app.package.list -f example",
      "explanation": "Finds installed packages by name."
    },
    {
      "id": 2,
      "category": "Recon",
      "command": "run app.package.info -a <package>",
      "example": "run app.package.info -a com.example.app",
      "explanation": "Version, data directory, UID and requested permissions."
    },
    {
      "id": 3,
      "category": "Recon",
      "command": "run app.package.attacksurface <package>",
      "example": "run app.package.attacksurface com.example.app",
      "explanation": "Counts exported activities, services, receivers and providers, and flags debuggable apps."
    },
    {
      "id": 14,
      "category": "Recon",
      "command": "run app.package.manifest <package>",
      "example": "run app.package.manifest com.example.app",
      "explanation": "Prints the manifest."
    },
    {
      "id": 4,
      "category": "Activities and services",
      "command": "run app.activity.info -a <package>",
      "example": "run app.activity.info -a com.example.app",
      "explanation": "Lists exported activities and the permissions protecting them."
    },
    {
      "id": 15,
      "category": "Activities and services",
      "command": "run app.activity.start --component <package> <activity>",
      "example": "run app.activity.start --component com.example.app com.example.app.AdminActivity",
      "explanation": "Starts an exported activity directly — tests for authentication bypass."
    },
    {
      "id": 16,
      "category": "Activities and services",
      "command": "run app.service.info -a <package>",
      "example": "run app.service.info -a com.example.app",
      "explanation": "Exported services."
    },
    {
      "id": 17,
      "category": "Activities and services",
      "command": "run app.broadcast.info -a <package>",
      "example": "run app.broadcast.info -a com.example.app",
      "explanation": "Exported broadcast receivers."
    },
    {
      "id": 18,
      "category": "Activities and services",
      "command": "run app.broadcast.send --action <action> --extra string <key> <value>",
      "example": "run app.broadcast.send --action com.example.RESET --extra string user admin",
      "explanation": "Sends a crafted broadcast to a receiver."
    },
    {
      "id": 6,
      "category": "Content providers",
      "command": "run app.provider.info -a <package>",
      "example": "run app.provider.info -a com.example.app",
      "explanation": "Exported content providers and their permissions."
    },
    {
      "id": 19,
      "category": "Content providers",
      "command": "run scanner.provider.finduris -a <package>",
      "example": "run scanner.provider.finduris -a com.example.app",
      "explanation": "Guesses accessible content URIs."
    },
    {
      "id": 7,
      "category": "Content providers",
      "command": "run app.provider.query <uri>",
      "example": "run app.provider.query content://com.example.app.provider/users",
      "explanation": "Queries a provider — may expose private data."
    },
    {
      "id": 8,
      "category": "Content providers",
      "command": "run scanner.provider.injection -a <package>",
      "example": "run scanner.provider.injection -a com.example.app",
      "explanation": "Tests providers for SQL injection."
    },
    {
      "id": 9,
      "category": "Content providers",
      "command": "run scanner.provider.traversal -a <package>",
      "example": "run scanner.provider.traversal -a com.example.app",
      "explanation": "Tests file-backed providers for path traversal."
    },
    {
      "id": 20,
      "category": "Content providers",
      "command": "run app.provider.read <uri>",
      "example": "run app.provider.read content://com.example.app.files/../../../../etc/hosts",
      "explanation": "Reads a file through a provider, for example to confirm traversal."
    }
  ]
}
